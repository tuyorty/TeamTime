# Скопируйте в .env и заполните. Пустые значения — безопасные значения по умолчанию.

# --- Telegram ---
# Токен от @BotFather. Без него бот не запускается, сайт работает.
BOT_TOKEN=
# Имя бота без @ — для ссылок «Исправить в боте».
BOT_USERNAME=

# --- Режим админа ---
# Пароль для правок на сайте. Пусто — режим админа выключен.
ADMIN_PASSWORD=
# Ключ подписи cookie. Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# --- Сайт ---
# Адрес сайта в локальной сети (бот вставляет его в ссылки).
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Часовой пояс по умолчанию (дальше меняется в настройках на сайте).
DEFAULT_TIMEZONE=Asia/Yekaterinburg

# --- Демо ---
# 1 — загрузить вымышленные данные при пустой базе и включить эмулятор чата.
DEMO=

# --- База ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
