# xTime на сервере. install.sh при первом запуске копирует этот файл в .env
# и сам заполняет POSTGRES_PASSWORD, SESSION_SECRET и PUBLIC_URL.

# --- обязательно заполнить ---
# Токен от @BotFather.
BOT_TOKEN=
# Имя бота без @ — для ссылок «Исправить в боте».
BOT_USERNAME=
# Пароль режима админа на сайте.
ADMIN_PASSWORD=

# --- сайт ---
# Порт сайта на сервере. Проверьте, что он свободен: 80 и 8080 часто уже заняты.
WEB_PORT=8090
# Адрес, по которому коллеги открывают сайт (бот вставляет его в ссылки).
PUBLIC_URL=
DEFAULT_TIMEZONE=Asia/Yekaterinburg

# --- Telegram ---
# Нужен, только если с сервера api.telegram.org недоступен напрямую
# (проверка: ./install.sh сам скажет). Пример: socks5://user:pass@10.0.0.5:1080
# Через SSH-туннель (xtime-tg-tunnel.service): socks5://172.17.0.1:1080
TELEGRAM_PROXY=

# --- служебное, заполняется автоматически ---
POSTGRES_PASSWORD=
SESSION_SECRET=
